{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/counter" },
    { "source": "/counter.svg", "destination": "/api/counter" }
  ],
  "headers": [
    {
      "source": "/api/counter",
      "headers": [
        { "key": "Cache-Control", "value": "max-age=0, no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
